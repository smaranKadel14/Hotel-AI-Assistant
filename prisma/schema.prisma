generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Sender {
  GUEST
  AI
  STAFF
}

model Hotel {
  id                String            @id @default(cuid())
  name              String
  slug              String            @unique
  address           String
  phone             String
  email             String
  rooms             Room[]
  facilities        Facility[]
  policies          Policy[]
  faqs              Faq[]
  conversations     Conversation[]
  bookingInquiries  BookingInquiry[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model Room {
  id          String   @id @default(cuid())
  hotelId     String
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name        String
  description String
  priceNpr    Float
  capacity    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([hotelId])
}

model Facility {
  id        String   @id @default(cuid())
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name      String
  category  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hotelId])
}

model Policy {
  id        String   @id @default(cuid())
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hotelId])
}

model Faq {
  id        String   @id @default(cuid())
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  question  String
  answer    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hotelId])
}

model Conversation {
  id               String          @id @default(cuid())
  hotelId          String
  hotel            Hotel           @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  channel          String          @default("WEB")
  guestName        String?
  messages         Message[]
  bookingInquiries BookingInquiry[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([hotelId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         Sender
  text           String
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model BookingInquiry {
  id             String       @id @default(cuid())
  hotelId        String
  hotel          Hotel        @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation  Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  guestName      String
  guestEmail     String
  guestPhone     String
  roomType       String?
  checkIn        DateTime?
  checkOut       DateTime?
  status         String       @default("PENDING")
  createdAt      DateTime     @default(now())

  @@index([hotelId])
  @@index([conversationId])
}
